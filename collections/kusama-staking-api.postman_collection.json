        {
          "id": "e173c6e2-cc27-47e1-ba59-1c8a9d812e76",
          "name": "Get payout information for a _Stash_ account.",
          "request": {
            "name": "Get payout information for a _Stash_ account.",
            "description": {
              "content": "Returns payout information for the last specified eras. If specifying both the depth and era query params, this endpoint will return information for (era - depth) through era. (i.e. if depth=5 and era=20 information will be returned for eras 16 through 20).\n\n**Asset Hub Migration Support:**\nFor Asset Hub chains that have migrated staking from the relay chain, this endpoint automatically handles era query routing:\n- **Pre-migration eras**: Queries historical data from the relay chain\n- **Post-migration eras**: Queries current data from Asset Hub\n- **Cross-migration queries**: Automatically splits the era range and combines results from both chains\n\n**Note:** The `nominator*` fields correspond to the address being queried, even if it is a validator's _Stash_ address. This is because a validator is technically nominating itself.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":accountId",
                "staking-payouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<unsignedInteger or $hex>",
                  "description": "Block at which to query staking payouts."
                },
                {
                  "disabled": false,
                  "key": "useRcBlock",
                  "value": "<boolean>",
                  "description": "When set to 'true', uses the relay chain block specified in the 'at' parameter to determine corresponding Asset Hub block(s) for retrieving staking payouts. Only supported for Asset Hub endpoints. Requires 'at' parameter to specify the relay chain block. When used, returns an array of response objects (one for each Asset Hub block found) or empty array if none found."
                },
                {
                  "disabled": false,
                  "key": "useRcBlockFormat",
                  "value": "<string>",
                  "description": "Controls the response format when using 'useRcBlock=true'. When set to 'object', wraps the response in an object containing relay chain block info ('rcBlock') and the parachain data array ('parachainDataPerBlock'). When set to 'array' or omitted, returns the standard array format. Only valid when 'useRcBlock=true' is specified."
                },
                {
                  "disabled": false,
                  "key": "depth",
                  "value": "1",
                  "description": "The number of eras to query for payouts of. Must be less than or equal to `HISTORY_DEPTH`. In cases where `era - (depth -1)` is less than 0, the first era queried will be 0."
                },
                {
                  "disabled": false,
                  "key": "era",
                  "value": "`active_era - 1`",
                  "description": "The era to query at."
                },
                {
                  "disabled": false,
                  "key": "unclaimedOnly",
                  "value": "true",
                  "description": "Only return unclaimed rewards."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<SS58>",
                  "key": "accountId",
                  "description": "(Required) SS58 address of the account. Must be a _Stash_ account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "bdbdfa57-70c6-4c54-9344-7b99a3d5a3a1",
