              "body": "{\n  \"at\": {\n    \"hash\": \"string\",\n    \"height\": \"string\"\n  },\n  \"erasPayouts\": [\n    {\n      \"era\": \"string\",\n      \"totalEraRewardPoints\": \"string\",\n      \"totalEraPayout\": \"string\",\n      \"payouts\": [\n        {\n          \"validatorId\": \"string\",\n          \"nominatorStakingPayout\": \"string\",\n          \"claimed\": false,\n          \"totalValidatorRewardPoints\": \"string\",\n          \"validatorCommission\": \"string\",\n          \"totalValidatorExposure\": \"string\",\n          \"nominatorExposure\": \"string\"\n        },\n        {\n          \"validatorId\": \"string\",\n          \"nominatorStakingPayout\": \"string\",\n          \"claimed\": true,\n          \"totalValidatorRewardPoints\": \"string\",\n          \"validatorCommission\": \"string\",\n          \"totalValidatorExposure\": \"string\",\n          \"nominatorExposure\": \"string\"\n        }\n      ]\n    },\n    {\n      \"era\": \"string\",\n      \"totalEraRewardPoints\": \"string\",\n      \"totalEraPayout\": \"string\",\n      \"payouts\": [\n        {\n          \"validatorId\": \"string\",\n          \"nominatorStakingPayout\": \"string\",\n          \"claimed\": false,\n          \"totalValidatorRewardPoints\": \"string\",\n          \"validatorCommission\": \"string\",\n          \"totalValidatorExposure\": \"string\",\n          \"nominatorExposure\": \"string\"\n        },\n        {\n          \"validatorId\": \"string\",\n          \"nominatorStakingPayout\": \"string\",\n          \"claimed\": false,\n          \"totalValidatorRewardPoints\": \"string\",\n          \"validatorCommission\": \"string\",\n          \"totalValidatorExposure\": \"string\",\n          \"nominatorExposure\": \"string\"\n        }\n      ]\n    }\n  ],\n  \"rcBlockHash\": \"string\",\n  \"rcBlockNumber\": \"string\",\n  \"ahTimestamp\": \"string\"\n}",
