          "id": "4549abf3-5a4b-4e9d-aee9-31d520fe989d",
          "name": "[DEPRECATION NOTE: PHASED OUT ENDPOINT IN FAVOR OF CORETIME] Get the status of the current auction.\n",
          "request": {
            "name": "[DEPRECATION NOTE: PHASED OUT ENDPOINT IN FAVOR OF CORETIME] Get the status of the current auction.\n",
            "description": {
              "content": "Returns an overview of the current auction. There is only one auction\nat a time. If there is no auction most fields will be `null`. If the current\nauction phase is in `vrfDelay` and you are looking to retrieve the latest winning\nbids, it is advised to query one block before `finishEnd` in the `endingPeriod` phase\nfor that auction as there technically are no winners during the `vrfDelay` and thus\nthe field is `null`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "paras",
                "auctions",
                "current"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<unsignedInteger or $hex>",
