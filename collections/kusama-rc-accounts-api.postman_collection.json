          "name": "Get balance information for an account on the relay chain.",
          "request": {
            "name": "Get balance information for an account on the relay chain.",
            "description": {
              "content": "Returns information about an account's balance on the relay chain. This endpoint is specifically for Asset Hub and queries the relay chain (Polkadot/Kusama) for balance information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rc",
                "accounts",
                ":address",
                "balance-info"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<unsignedInteger or $hex>",
                  "description": "Block at which to query balance info for the specified account."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Token to query the balance of. If not specified it will query the chains native token (e.g. DOT for Polkadot). Note: this is only relevant for chains that support multiple tokens through the ORML tokens pallet."
                },
                {
                  "disabled": false,
                  "key": "denominated",
                  "value": "false",
                  "description": "When set to `true` it will denominate any balance's given atomic value using the chains given decimal value."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<SS58>",
                  "key": "address",
                  "description": "(Required) SS58 address of the account."
                }
